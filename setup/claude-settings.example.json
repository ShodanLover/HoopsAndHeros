{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "agent-sprite-forge": {
      "source": { "source": "github", "repo": "0x0funky/agent-sprite-forge" }
    }
  },
  "enabledPlugins": {
    "agent-sprite-forge@agent-sprite-forge": true
  },
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run check)",
      "Bash(npm test)",
      "Bash(npm run smoke)",
      "Bash(npm run balance)",
      "Bash(npm run calibrate)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)"
    ]
  }
}
